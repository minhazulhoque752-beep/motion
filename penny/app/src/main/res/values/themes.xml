<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base window theme. All in-app styling is done in Compose (ui/theme). -->
    <style name="Theme.Penny" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/penny_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Splash screen (androidx.core:core-splashscreen, backported to API 26+) -->
    <style name="Theme.Penny.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/penny_paper</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/penny_forest</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Penny</item>
    </style>
</resources>
